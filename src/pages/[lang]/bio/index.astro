---
/**
 * /{lang}/bio (bio/index.{en,es}.js port): BioImage (profile, full-width) +
 * static paragraphs, the CV online|pdf links, and the pics gallery
 * (pics.js: 18 pics, FULL_WIDTH 1.5 AR) + `Random pics, by <0>Nicolás
 * Croce</0>.` line. Slice 3 (task 3.3) adds the images: profile full-width
 * without a fixed AR (Gatsby FULL_WIDTH), each pic server-cropped to a 1.5
 * box via explicit width/height (v6 default-crop — the pinned line has no
 * aspectRatio prop, research gate 5.1) at [420,840,1680], all with
 * webp/avif + blurred placeholder. Phase 5.3 hydrates the cyclic-fade island
 * over the same pics (interim: static CSS grid).
 */
import Main from '../../../layouts/Main.astro'
import { localeParams, t, localizePath } from '../../../lib/locale'
import BlurredPicture from '../../../components/BlurredPicture.astro'
import type { ImageMetadata } from 'astro'

export function getStaticPaths() {
  return localeParams()
}

const { lang } = Astro.params

const randomPicsKey = t(lang, 'Random Pics')
const randomPicsMatch = randomPicsKey.match(/<0>(.*?)<\/0>/)
const [randomPicsBefore, randomPicsAfter] = randomPicsKey.split(/<0>.*?<\/0>/)
// Trans port: the <0>…</0> placeholder becomes the anchor, its inner text
// the label (e.g. "Nicolás Croce") — never emitted as literal text.
const croceLabel = randomPicsMatch?.[1] ?? 'Nicolás Croce'
const isEn = lang === 'en'

// pics.js port: every image under content/assets/pics/ (18), deterministic
// order by path. Decorative-by-commission photos — Gatsby rendered them
// without alt; keep alt="" (aria-hidden-equivalent) as the gallery is
// auxiliary content.
// `import: 'default'` is REQUIRED: eager import.meta.glob returns module
// namespace objects ({ default: ImageMetadata }); without it, src.format is
// undefined and every getImage/Picture call throws UnsupportedImageFormat.
const pics = (
  Object.entries(
    import.meta.glob('/content/assets/pics/*.{jpg,jpeg,png}', {
      eager: true,
      import: 'default',
    }) as Record<string, ImageMetadata>,
  )
    .sort(([a], [b]) => a.localeCompare(b))
    .map(([, meta]) => meta)
)
// bioImage.js port: profile.jpg, full-width, natural AR (Gatsby FULL_WIDTH).
const profile =
  import.meta.glob('/content/assets/profile.jpg', {
    eager: true,
    import: 'default',
  })['/content/assets/profile.jpg'] as ImageMetadata
---

<Main pageTitle="bio" locale={lang} pathname={`/${lang}/bio`}>
  <div class="bio">
    <BlurredPicture
      src={profile}
      alt=""
      widths={[420, 840, 1680]}
      sizes="100vw"
      layout="full-width"
      class="bio-profile"
    />
    <p class="spacey">
      {isEn ? (
        <>
          Diego Dorado is a live coder, programmer and electronic artist based in
          Agentina. He is passionate about research projects that combine
          technological innovation with artistic expressions.
          <br />
          He has worked as an educator, sound designer, composer, video games and
          web developer.
          <br /> <br />
          He has participated in various works of electronic art coding on
          microcontrollers, videogames, signal processing, audiovisuals, sound
          data and interactive webs; as well as for different formats: virtual
          reality, augmented reality, fulldome, mapping, audiovisual performance,
          sound installations and e-textiles.
        </>
      ) : (
        <>
          Diego Dorado es live coder, programador y artista electrónico argentino.
          Le apasionan los proyectos de investigación que combinan innovación
          tecnológica con expresiones artísticas.
          <br />
          Ha trabajado como educador, diseñador sonoro, compositor y como
          desarrollador web y de videojuegos.
          <br /> <br />
          Ha participado en obras de arte electrónico programando para
          microcontroladores, videojuegos, procesamiento de señales,
          audiovisuales, sonorización de datos y webs interactivas; así como para
          diferentes formatos: realidad virtual, realidad aumentada, fulldome,
          mapping, performance audiovisual, instalaciones sonoras y
          tecno-textiles.
        </>
      )}
      <br /> <br />
      Curriculum Vitae: <a href={localizePath('/bio/cv', lang)}>online</a> |{' '}
      <a target="_blank" rel="noopener noreferrer" href="/es/cv-diego-dorado.pdf">
        pdf
      </a>
      <br /> <br /> <br />
    </p>
    <section class="bio-pics">
      {pics.map((pic) => (
        <BlurredPicture
          src={pic}
          alt=""
          widths={[420, 840, 1680]}
          sizes="100vw"
          layout="full-width"
          width={1680}
          height={1120}
          ratio={1.5}
        />
      ))}
    </section>
    <p>
      {randomPicsBefore}
      <a target="_blank" rel="noopener noreferrer" href="https://www.facebook.com/nicolascroceph">
        {croceLabel}
      </a>
      {randomPicsAfter}
    </p>
  </div>
</Main>

<style>
  /* Interim static layout: Phase 5.3 replaces the grid with the cyclic-fade
     island over the same pictures. */
  .bio-pics {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(14rem, 1fr));
    gap: 1.25rem;
    margin-bottom: 1.5rem;
  }
  .bio-profile {
    margin-bottom: 1.5rem;
  }
</style>