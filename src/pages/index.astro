---
import Main from '../layouts/Main.astro'
---

<Main pageTitle="home" locale="en" pathname="/">
  <p style="text-align: center"></p>
</Main>

<script is:inline>
  (() => {
    const lang = (function () {
      const list = (navigator.languages && navigator.languages.length ? navigator.languages : [navigator.language]).filter(Boolean)
      return list.find((l) => l.toLowerCase().startsWith('es')) ? 'es' : 'en'
    })()
    location.replace('/' + lang + '/work')
  })()
</script>