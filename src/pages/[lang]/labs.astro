---
import Main from '../../layouts/Main.astro'
import { localeParams, t } from '../../lib/locale'
import LabsImage from '../../components/labs/LabsImage.astro'
import { labs } from '../../data/labs'

export function getStaticPaths() {
  return localeParams()
}

const { lang } = Astro.params
---

<Main pageTitle="labs" locale={lang} pathname={`/${lang}/labs`}>
  <p class="spacey">{t(lang, 'IntroLabs')}</p>
  <section class="posts">
    {
      labs.map((lab) => {
        const desc =
          lab[`description_${lang}` as 'description_en' | 'description_es']

        const link = (content: any) => (
          <a href={lab.link} target="_blank" rel="noopener noreferrer">
            {content}
          </a>
        )

        return (
          <article>
            {link(
              <LabsImage
                name={lab.image.split('/').pop() ?? lab.image}
                alt={lab.title}
              />
            )}

            <h3>{link(lab.title)}</h3>
            <p>{desc}</p>
          </article>
        )
      })
    }
    <article></article>
    <article></article>
    <article></article>
  </section>
</Main>
