---
/**
 * LanguagesLinks (languages-links.js port). SSR emits plain hrefs; the
 * client-side navigate() is replaced by real links:
 *  - localized pages: prefix-swap between /en/* and /es/*
 *  - non-localized pages (/, 404, app, static leaves): same path, active
 *    class marks the current locale (original changeLanguage-only behavior).
 */
import { swapLocale, type Locale } from '../../lib/locale'

interface Props {
  locale: Locale
  pathname: string
}

const { locale, pathname } = Astro.props
const alternate = locale === 'en' ? 'es' : 'en'
const esHref = locale === 'es' ? pathname : swapLocale(pathname, locale)
const enHref = locale === 'en' ? pathname : swapLocale(pathname, locale)
---

<a href={esHref} class={locale === 'es' ? 'active' : ''}>es</a>/
<a href={enHref} class={locale === 'en' ? 'active' : ''}>en</a>