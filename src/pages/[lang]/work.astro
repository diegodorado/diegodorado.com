---
/**
 * /{lang}/work (work.js port, D2/D3): Intro + "Recent works:" + the works
 * listing built from the `works` collection — index works whose locale matches
 * the page (or locale-agnostic), date DESC, as Gatsby's work.js query did.
 * Cover images land in the imagery slice (3) — the 3 empty filler articles
 * that line up the grid stay until then.
 */
import Main from '../../layouts/Main.astro'
import { getCollection } from 'astro:content'
import { deriveWorks } from '../../lib/routes'
import { localizePath, localeParams, t } from '../../lib/locale'

export async function getStaticPaths() {
  return localeParams()
}

const { lang } = Astro.params
const works = await getCollection('works')
const list = deriveWorks(works)
  .filter((w) => w.index && (w.locale === '' || w.locale === lang))
  .sort(
    (a, b) =>
      (b.entry.data.date?.getTime() ?? 0) - (a.entry.data.date?.getTime() ?? 0),
  )
---

<Main pageTitle={t(lang, 'Work')} locale={lang} pathname={`/${lang}/work`}>
  <p class="spacey">{t(lang, 'Intro')}</p>
  <p>{t(lang, 'Recent works')}:</p>
  <section class="posts">
    {list.map((w) => (
      <article>
        <a href={localizePath(w.slug, lang)}>
          <h3>{w.entry.data.title}</h3>
          {w.entry.data.description ? <p>{w.entry.data.description}</p> : null}
        </a>
      </article>
    ))}
    {/* 3 empty fillers keep the grid aligned (covers land in slice 3) */}
    <article></article>
    <article></article>
    <article></article>
  </section>
</Main>