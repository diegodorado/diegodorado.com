---
/**
 * 404 (404.js port): rendered through the standard layout, en shell (Gatsby
 * SSR default locale), title "404: Not Found".
 */
import Main from '../layouts/Main.astro'
---

<Main pageTitle="404: Not Found" locale="en" pathname="/404">
  <h1>Not Found</h1>
  <p>You just hit a route that doesn't exist... the sadness.</p>
</Main>