---
import { localeParams } from '../../../lib/locale'
import AdaWeaves from '../../../components/labs/AdaWeaves.jsx'
import '../../../styles/ada.sass'

export function getStaticPaths() {
  return localeParams()
}
---

<!doctype html>
<html lang={Astro.params.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
  </head>
  <body class="ada-embed">
    <AdaWeaves embed client:visible />
  </body>
</html>
