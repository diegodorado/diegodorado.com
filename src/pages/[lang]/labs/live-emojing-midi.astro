---
/**
 * /{lang}/labs/live-emojing-midi (live-emojing-midi.js port).
 * NOTE: emoji-mart dependencies were dropped in Phase 1 (owner decision).
 */
import Main from '../../../layouts/Main.astro'
import { localeParams } from '../../../lib/locale'

export function getStaticPaths() {
  return localeParams()
}

const { lang } = Astro.params
---

<Main pageTitle="live emojing" locale={lang} pathname={`/${lang}/labs/live-emojing-midi`}>
  <div class="live-emojing">
    <p>Make music with emojis!</p>
    <p>Cannot get channels list.</p>
    <p>Want to play on your own?</p>
    <p>play alone</p>
  </div>
</Main>
