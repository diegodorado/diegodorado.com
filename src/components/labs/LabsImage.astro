---
/**
 * Labs grid image (D4, task 3.2): fixed 320x320 blurred picture for a labs
 * entry. The labs YAML (src/data/labs.yaml, gatsby-transformer-yaml port
 * target) references images as `labs/<file>`; this component globs the real
 * on-disk store `content/assets/labs/*.{png,jpg}` and looks the entry up by
 * basename. Phase 5 labs pages consume this (the labs hubs + island pages);
 * the component itself is build-time proven by `yarn check` — the emitted
 * HTML for it lands with the Phase 5 routes.
 */
import BlurredPicture from '../BlurredPicture.astro'
import type { ImageMetadata } from 'astro'

// `import: 'default'`: eager glob returns namespace objects otherwise, which
// break getImage (src.format undefined -> UnsupportedImageFormat).
const labsImages = import.meta.glob('/src/data/labs/*.{png,jpg}', {
  eager: true,
  import: 'default',
}) as Record<string, ImageMetadata>

const byName = Object.fromEntries(
  Object.entries(labsImages).map(([path, meta]) => [
    path.split('/').pop() ?? path,
    meta,
  ]),
)

interface Props {
  /** labs YAML `image` basename, e.g. "ada.png" */
  name: string
  alt: string
}

const { name, alt } = Astro.props
const src = byName[name]
---

{src ? (
  <BlurredPicture
    src={src}
    alt={alt}
    widths={[320]}
    sizes="320px"
    layout="fixed"
    width={320}
    height={320}
  />
) : null}