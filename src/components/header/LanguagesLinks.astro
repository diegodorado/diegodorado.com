---
/**
 * LanguagesLinks (languages-links.js port, D3): SSR emits plain hrefs; the
 * client-side navigate() is replaced by real links via astro:i18n's
 * getRelativeLocaleUrl:
 *  - localized pages: prefix-swap between /en/* and /es/*
 *  - non-localized pages (/, 404, app, static leaves): same path, active
 *    class marks the current locale (original changeLanguage-only behavior).
 */
import { getRelativeLocaleUrl } from 'astro:i18n'
import type { Locale } from '../../lib/locale'

interface Props {
  locale: Locale
  pathname: string
}

const { locale, pathname } = Astro.props

// Swap the locale prefix on /en|/es-prefixed paths, keep the same path on
// non-localized pages. getRelativeLocaleUrl resolves paths from the
// default-locale space (D10), so strip the prefix first.
const swap = (to: Locale): string =>
  pathname.startsWith(`/${locale}/`)
    ? getRelativeLocaleUrl(to, pathname.slice(`/${locale}`.length) || '/')
    : pathname

const esHref = locale === 'es' ? pathname : swap('es')
const enHref = locale === 'en' ? pathname : swap('en')
---

<a href={esHref} class={locale === 'es' ? 'active' : ''}>es</a>/
<a href={enHref} class={locale === 'en' ? 'active' : ''}>en</a>